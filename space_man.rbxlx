    <Item class="StarterPlayerScripts" referent="14">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="15">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict
-- Client entry point: HUD toasts, screen fades, and launch camera shake.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Notifier = require(script.ui.Notifier)

Notifier.init()

Remotes.event("Notify").OnClientEvent:Connect(function(message: string)
	Notifier.show(message)
end)

Remotes.event("Screen").OnClientEvent:Connect(function(action: string, duration: number)
	Notifier.fade(action, duration)
end)

Remotes.event("Launch").OnClientEvent:Connect(function(duration: number)
	local character = Players.LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local elapsed = 0
	local connection: RBXScriptConnection? = nil
	connection = RunService.RenderStepped:Connect(function(dt: number)
		elapsed += dt
		if elapsed >= duration then
			humanoid.CameraOffset = Vector3.zero
			if connection then
				connection:Disconnect()
			end
			return
		end
		local shake = 0.5
		humanoid.CameraOffset = Vector3.new(
			(math.random() - 0.5) * shake,
			(math.random() - 0.5) * shake,
			(math.random() - 0.5) * shake
		)
	end)
end)

-- Rescue button: server tells us when to show it; clicking asks for pickup.
Remotes.event("RescuePrompt").OnClientEvent:Connect(function(show: boolean)
	Notifier.setRescueVisible(show)
end)

Notifier.RescueClicked:Connect(function()
	Remotes.event("Rescue"):FireServer()
end)
]]></string>
        </Properties>
        <Item class="Folder" referent="16">
          <Properties>
            <string name="Name">ui</string>
          </Properties>
          <Item class="ModuleScript" referent="17">
            <Properties>
              <string name="Name">Notifier</string>
              <string name="Source"><![CDATA[--!strict
-- HUD: server-message toasts, full-screen fades, and a small rescue button.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Notifier = {}

local label: TextLabel? = nil
local fadeFrame: Frame? = nil
local rescueButton: TextButton? = nil

local rescueClicked = Instance.new("BindableEvent")
Notifier.RescueClicked = rescueClicked.Event

function Notifier.init()
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")

	local gui = Instance.new("ScreenGui")
	gui.Name = "SpaceManHUD"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = playerGui

	local fade = Instance.new("Frame")
	fade.Name = "Fade"
	fade.Size = UDim2.fromScale(1, 1)
	fade.BackgroundColor3 = Color3.new(0, 0, 0)
	fade.BackgroundTransparency = 1
	fade.BorderSizePixel = 0
	fade.ZIndex = 10
	fade.Parent = gui
	fadeFrame = fade

	local toast = Instance.new("TextLabel")
	toast.Name = "Toast"
	toast.AnchorPoint = Vector2.new(0.5, 0)
	toast.Position = UDim2.new(0.5, 0, 0.08, 0)
	toast.Size = UDim2.new(0, 540, 0, 50)
	toast.BackgroundColor3 = Color3.fromRGB(15, 18, 28)
	toast.BackgroundTransparency = 1
	toast.TextColor3 = Color3.fromRGB(235, 240, 245)
	toast.Font = Enum.Font.GothamMedium
	toast.TextScaled = true
	toast.Text = ""
	toast.TextTransparency = 1
	toast.ZIndex = 2

	local toastCorner = Instance.new("UICorner")
	toastCorner.CornerRadius = UDim.new(0, 10)
	toastCorner.Parent = toast

	local toastPad = Instance.new("UIPadding")
	toastPad.PaddingLeft = UDim.new(0, 16)
	toastPad.PaddingRight = UDim.new(0, 16)
	toastPad.Parent = toast

	toast.Parent = gui
	label = toast

	-- Small, unobtrusive action button (hidden until needed).
	local button = Instance.new("TextButton")
	button.Name = "RescueButton"
	button.AnchorPoint = Vector2.new(0.5, 1)
	button.Position = UDim2.new(0.5, 0, 0.86, 0)
	button.Size = UDim2.new(0, 210, 0, 40)
	button.BackgroundColor3 = Color3.fromRGB(225, 95, 60)
	button.TextColor3 = Color3.fromRGB(255, 255, 255)
	button.Font = Enum.Font.GothamBold
	button.TextSize = 16
	button.Text = "🚤 Activate Rescue Boats"
	button.AutoButtonColor = true
	button.Visible = false
	button.ZIndex = 5

	local buttonCorner = Instance.new("UICorner")
	buttonCorner.CornerRadius = UDim.new(0, 8)
	buttonCorner.Parent = button

	button.Activated:Connect(function()
		button.Visible = false
		rescueClicked:Fire()
	end)

	button.Parent = gui
	rescueButton = button
end

function Notifier.show(message: string)
	local toast = label
	if not toast then
		return
	end
	toast.Text = message
	TweenService:Create(toast, TweenInfo.new(0.2), {
		TextTransparency = 0,
		BackgroundTransparency = 0.2,
	}):Play()

	task.delay(3.5, function()
		if toast.Text == message then
			TweenService:Create(toast, TweenInfo.new(0.4), {
				TextTransparency = 1,
				BackgroundTransparency = 1,
			}):Play()
		end
	end)
end

function Notifier.fade(action: string, duration: number)
	local frame = fadeFrame
	if not frame then
		return
	end
	local goal = if action == "out" then 0 else 1
	TweenService:Create(frame, TweenInfo.new(duration), { BackgroundTransparency = goal }):Play()
end

function Notifier.setRescueVisible(visible: boolean)
	if rescueButton then
		rescueButton.Visible = visible
	end
end

return Notifier
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
