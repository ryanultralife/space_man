      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- Central tunables for space_man. Edit values here; every system reads from this.

local Config = {}

-- Roblox gravity units (default Workspace.Gravity is 196.2 ≈ Earth's 9.81 m/s²).
-- Other bodies are scaled by their real surface-gravity ratio to Earth.
Config.Gravity = {
	Earth = 196.2,
	Moon = 32.4, -- ~1.62 / 9.81 * 196.2
	Mars = 74.4, -- ~3.72 / 9.81 * 196.2
	Orbit = 0, -- microgravity
} :: { [string]: number }

-- Which world this place currently represents.
-- (Later milestone: split worlds into separate Roblox places and teleport between them.)
Config.CurrentWorld = "Earth"

Config.Suit = {
	HelmetColor = Color3.fromRGB(235, 240, 245),
	SuitColor = Color3.fromRGB(220, 224, 230),
	PromptDistance = 9,
}

Config.Rocket = {
	-- Seconds for the crawler to roll the rocket from the assembly building to the pad.
	RolloutSeconds = 30,
	RolloutReturnSeconds = 8, -- crawler retreat back to the VAB afterwards
	PromptDistance = 11,
}

Config.Launch = {
	CountdownFrom = 5,
	AscentSeconds = 7,
	AscentHeight = 260,
	FadeSeconds = 0.7,
}

Config.Orbit = {
	-- Where the orbit scene lives (far from the launch site; we relocate the player here).
	Center = Vector3.new(0, 0, 6000),
}

Config.Splashdown = {
	Point = Vector3.new(480, 0, -10), -- middle of the ocean, east of the Cape
	StartHeight = 360, -- altitude the parachute descent begins from
	FloatY = 1.5, -- where the capsule rests, half-submerged
	DescentSeconds = 9,
}

Config.Rescue = {
	ShoreX = 160, -- where rescue boats set off from
	BoatSpeedSeconds = 5,
}

Config.Ocean = {
	Center = Vector3.new(520, -20, -10),
	Size = Vector3.new(760, 40, 520),
}

Config.Rover = {
	Speed = 42,
	TurnRate = 1.8,
}

Config.Surface = {
	-- Reusable surface world (recoloured per destination), far from the launch site.
	Center = Vector3.new(0, 0, 12000),
}

Config.Destinations = { "EarthOrbit", "Moon", "Mars" }

Config.Servers = {
	PublicMax = 1, -- public/normal servers are solo
	PrivateMax = 4, -- free private servers hold up to 4 (the Artemis crew size)
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!strict
-- Accessor for networking objects. The server creates them on demand;
-- the client waits for them. Keeps remote wiring in one place.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "Remotes"

local Remotes = {}

local function getFolder(): Folder
	if RunService:IsServer() then
		local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = FOLDER_NAME
			folder.Parent = ReplicatedStorage
		end
		return folder :: Folder
	end
	return ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
end

function Remotes.event(name: string): RemoteEvent
	local folder = getFolder()
	if RunService:IsServer() then
		local ev = folder:FindFirstChild(name)
		if not ev then
			ev = Instance.new("RemoteEvent")
			ev.Name = name
			ev.Parent = folder
		end
		return ev :: RemoteEvent
	end
	return folder:WaitForChild(name) :: RemoteEvent
end

return Remotes
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="5">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="6">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Server entry point. Everything is wrapped so that if any system fails to start,
-- a big red sign appears in-game with the error (instead of the world silently
-- not building) — makes problems easy to spot and report.

local Workspace = game:GetService("Workspace")

local function showError(message: string)
	warn("[space_man] STARTUP ERROR: " .. message)
	local anchor = Instance.new("Part")
	anchor.Name = "SpaceManError"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.Transparency = 1
	anchor.Position = Vector3.new(0, 24, 48)
	anchor.Parent = Workspace

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.new(0, 900, 0, 240)
	billboard.AlwaysOnTop = true
	billboard.Adornee = anchor
	billboard.Parent = anchor

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = Color3.fromRGB(120, 0, 0)
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.Font = Enum.Font.Code
	label.TextScaled = true
	label.Text = "space_man failed to start:\n\n" .. message
	label.Parent = billboard
end

local ok, err = pcall(function()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local Config = require(ReplicatedStorage.Shared.Config)

	local ServerCapacity = require(script.systems.ServerCapacity)
	local WorldBuilder = require(script.systems.WorldBuilder)
	local SuitSystem = require(script.systems.SuitSystem)
	local LaunchSystem = require(script.systems.LaunchSystem)
	local RocketBoarding = require(script.systems.RocketBoarding)

	ServerCapacity.apply()
	Workspace.Gravity = Config.Gravity[Config.CurrentWorld] or 196.2

	local complex = WorldBuilder.build()
	SuitSystem.start(complex)
	LaunchSystem.start(complex)
	RocketBoarding.start(complex, LaunchSystem)

	print(`[space_man] server ready — world: {Config.CurrentWorld}, gravity: {Workspace.Gravity}`)
end)

if not ok then
	showError(tostring(err))
end
]]></string>
      </Properties>
      <Item class="Folder" referent="7">
        <Properties>
          <string name="Name">systems</string>
        </Properties>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">LaunchSystem</string>
            <string name="Source"><![CDATA[--!strict
-- Orchestrates missions for a CREW (1 player for the Standard rocket, up to 4 for the
-- Artemis). A mission: countdown → ignition → ascent → arrival (orbit + satellite, or
-- a low-gravity surface) → "Return to Earth" → parachute splashdown → rescue-boat pickup.
-- Only ONE mission runs at a time. The flow self-resets if a crew member dies or leaves.
--
-- Standard rocket: assembled at the VAB, rolled out to the pad, solo, uses the flight
-- plan's destination. Artemis: on its own pad, unlocked only in a free private server
-- with 2+ players, carries up to 4 to the Moon together.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local WorldBuilder = require(script.Parent.WorldBuilder)

local LaunchSystem = {}

local notify = Remotes.event("Notify")
local launchFX = Remotes.event("Launch")
local screen = Remotes.event("Screen")
local rescuePrompt = Remotes.event("RescuePrompt")
local rescue = Remotes.event("Rescue")

local DEST_LABEL = { EarthOrbit = "Earth Orbit", Moon = "the Moon", Mars = "Mars" }
local MOON_GROUND = Color3.fromRGB(150, 150, 156)
local MARS_GROUND = Color3.fromRGB(170, 92, 58)

local complex: any = nil
local inFlight = false
local rollingOut = false
local rocketAtPad = false
local canReturn = false
local awaitingRescue = false
local crew: { Player } = {}
local missionModel: Model? = nil
local missionEngineFX: BasePart? = nil
local missionResetCF: CFrame? = nil
local missionDest = "EarthOrbit"
local savedLighting: { [string]: any }? = nil
local abortConns: { RBXScriptConnection } = {}
local deployedSats: { { name: string, status: string } } = {}

local function labelFor(dest: string): string
	return DEST_LABEL[dest] or dest
end

local function humanoidOf(player: Player): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function isCrew(player: Player): boolean
	return table.find(crew, player) ~= nil
end

local function notifyCrew(message: string)
	for _, p in crew do
		notify:FireClient(p, message)
	end
end

local function fadeCrew(action: string, duration: number)
	for _, p in crew do
		screen:FireClient(p, action, duration)
	end
end

local function refreshMonitor()
	if not complex then
		return
	end
	if #deployedSats == 0 then
		complex.MonitorLabel.Text = "No satellites deployed yet.\n\nFly an Earth Orbit mission\nto deploy one."
		return
	end
	local lines = {}
	for _, s in deployedSats do
		table.insert(lines, `{s.name}   [ ● {s.status} ]`)
	end
	complex.MonitorLabel.Text = `In orbit: {#deployedSats}\n\n` .. table.concat(lines, "\n")
end

local function setEngine(fx: BasePart?, on: boolean)
	if not fx then
		return
	end
	for _, d in fx:GetChildren() do
		if d:IsA("ParticleEmitter") or d:IsA("PointLight") then
			(d :: any).Enabled = on
		end
	end
end

local function setParachute(show: boolean)
	local chute = complex.DescentRig:FindFirstChild("Parachute")
	if not chute then
		return
	end
	for _, p in chute:GetDescendants() do
		if p:IsA("BasePart") then
			p.Transparency = if show then (p:GetAttribute("Vis") or 0) else 1
		end
	end
end

local function setSpaceLighting()
	if savedLighting then
		return
	end
	savedLighting = {
		ClockTime = Lighting.ClockTime,
		Brightness = Lighting.Brightness,
		OutdoorAmbient = Lighting.OutdoorAmbient,
		Ambient = Lighting.Ambient,
		FogEnd = Lighting.FogEnd,
	}
	Lighting.ClockTime = 0
	Lighting.Brightness = 1
	Lighting.OutdoorAmbient = Color3.fromRGB(18, 18, 28)
	Lighting.Ambient = Color3.fromRGB(12, 12, 22)
	Lighting.FogEnd = 1e9
end

local function restoreLighting()
	local s = savedLighting
	if not s then
		return
	end
	for k, v in s do
		(Lighting :: any)[k] = v
	end
	savedLighting = nil
end

local function resetMissionVehicle()
	setEngine(missionEngineFX, false)
	if missionModel and missionResetCF then
		missionModel:PivotTo(missionResetCF)
	end
end

local function resetDescent()
	complex.DescentRig:PivotTo(complex.DescentParked)
	setParachute(true)
end

local function endFlight()
	for _, c in abortConns do
		c:Disconnect()
	end
	abortConns = {}
	restoreLighting()
	Workspace.Gravity = Config.Gravity.Earth
	setEngine(complex.EngineFX, false)
	setEngine(complex.ArtemisEngineFX, false)
	complex.Rocket:PivotTo(complex.RocketVAB)
	complex.Crawler:PivotTo(complex.CrawlerVAB)
	complex.Artemis:PivotTo(complex.ArtemisStart)
	resetDescent()
	inFlight = false
	canReturn = false
	awaitingRescue = false
	rocketAtPad = false
	crew = {}
	missionModel = nil
	missionEngineFX = nil
	missionResetCF = nil
end

local function connectAborts()
	for _, p in crew do
		table.insert(abortConns, p.CharacterRemoving:Connect(endFlight))
	end
end

local function placeCrewSurface()
	for _, p in crew do
		local hum = humanoidOf(p)
		if hum then
			hum.Sit = false
		end
	end
	task.wait(0.15)
	for i, p in crew do
		if p.Character then
			p.Character:PivotTo(complex.SurfaceSpawn * CFrame.new((i - 1) * 5, 0, 0))
		end
	end
end

local function placeCrewOrbit()
	for i, p in crew do
		local hum = humanoidOf(p)
		if not hum then
			continue
		end
		if i == 1 then
			complex.OrbitSeat:Sit(hum)
		else
			hum.Sit = false
			if p.Character then
				p.Character:PivotTo(complex.OrbitDeck.CFrame * CFrame.new((i - 2) * 4 - 2, 4, 0))
			end
		end
	end
end

local function runMission()
	task.spawn(function()
		for n = Config.Launch.CountdownFrom, 1, -1 do
			if not inFlight then
				return
			end
			notifyCrew(`T-minus {n}...`)
			task.wait(1)
		end
		if not inFlight then
			return
		end

		notifyCrew("🔥 Liftoff!")
		setEngine(missionEngineFX, true)
		for _, p in crew do
			launchFX:FireClient(p, Config.Launch.AscentSeconds)
		end

		local model = missionModel :: Model
		local start = model:GetPivot()
		local dur = Config.Launch.AscentSeconds
		local height = Config.Launch.AscentHeight
		local t = 0
		while t < dur do
			local dt = task.wait()
			t += dt
			if not inFlight then
				return
			end
			local f = math.clamp(t / dur, 0, 1)
			model:PivotTo(start + Vector3.new(0, height * f * f, 0))
		end

		notifyCrew(`🛰️ Stage separation — on course for {labelFor(missionDest)}.`)
		task.wait(1)
		if not inFlight then
			return
		end

		fadeCrew("out", Config.Launch.FadeSeconds)
		task.wait(Config.Launch.FadeSeconds + 0.1)
		setSpaceLighting()

		if missionDest == "Moon" or missionDest == "Mars" then
			Workspace.Gravity = Config.Gravity[missionDest] or Config.Gravity.Moon
			complex.SurfaceGround.Color = if missionDest == "Mars" then MARS_GROUND else MOON_GROUND
			placeCrewSurface()
			resetMissionVehicle()
			fadeCrew("in", 0.9)
			task.wait(0.3)
			notifyCrew(`🛬 Touchdown on {labelFor(missionDest)}! Explore — return via the ascent stage.`)
			canReturn = true
		else
			placeCrewOrbit()
			task.wait(0.1)
			resetMissionVehicle()
			fadeCrew("in", 0.8)
			task.wait(0.8)
			notifyCrew("🌍 Orbit achieved! Deploying satellite...")

			local idx = #deployedSats + 1
			local name = string.format("SAT-%02d", idx)
			local sat = WorldBuilder.makeSatellite(Config.Orbit.Center + Vector3.new(18, 2 + idx * 3, 0))
			local from = sat:GetPivot()
			local st = 0
			while st < 2.5 do
				local dt = task.wait()
				st += dt
				sat:PivotTo(from + Vector3.new(math.min(st, 2.5) * 8, 0, math.sin(st * 2) * 4))
			end

			table.insert(deployedSats, { name = name, status = "Nominal" })
			refreshMonitor()
			notifyCrew(`🛰️ {name} deployed and nominal — track it at Mission Control.`)
			canReturn = true
		end
	end)
end

function LaunchSystem.isBusy(): boolean
	return inFlight or rollingOut
end

function LaunchSystem.isReady(): boolean
	return rocketAtPad and not inFlight and not rollingOut
end

function LaunchSystem.beginRollout(player: Player)
	if inFlight or rollingOut then
		notify:FireClient(player, "🚜 Hold on — something's already moving.")
		return
	end
	if rocketAtPad then
		notify:FireClient(player, "The rocket is already on the pad — suit up and board!")
		return
	end
	rollingOut = true
	notify:FireClient(player, `🚜 Assembling and rolling the rocket out to the pad (~{Config.Rocket.RolloutSeconds}s)...`)

	task.spawn(function()
		complex.Crawler:PivotTo(complex.CrawlerVAB)
		local rFrom, rTo = complex.RocketVAB, complex.RocketStart
		local cFrom, cTo = complex.CrawlerVAB, complex.CrawlerPad
		local dur = Config.Rocket.RolloutSeconds
		local t = 0
		while t < dur do
			local dt = task.wait()
			t += dt
			local f = math.clamp(t / dur, 0, 1)
			complex.Rocket:PivotTo(rFrom:Lerp(rTo, f))
			complex.Crawler:PivotTo(cFrom:Lerp(cTo, f))
		end
		complex.Rocket:PivotTo(rTo)
		complex.Crawler:PivotTo(cTo)
		rocketAtPad = true
		rollingOut = false
		notify:FireClient(player, "🚀 Rocket's on the pad! Suit up and board.")

		local rdur = Config.Rocket.RolloutReturnSeconds
		local rt = 0
		while rt < rdur do
			local dt = task.wait()
			rt += dt
			complex.Crawler:PivotTo(cTo:Lerp(cFrom, math.clamp(rt / rdur, 0, 1)))
		end
		complex.Crawler:PivotTo(cFrom)
	end)
end

-- Standard rocket: solo crew of 1, uses the flight-plan destination.
function LaunchSystem.beginCountdown(player: Player)
	if inFlight then
		notify:FireClient(player, "A launch is already in progress — stand by.")
		return
	end
	if not humanoidOf(player) then
		return
	end
	crew = { player }
	missionModel = complex.Rocket
	missionEngineFX = complex.EngineFX
	missionResetCF = complex.RocketVAB
	missionDest = complex.FlightConsole:GetAttribute("Dest") or "EarthOrbit"
	inFlight = true
	connectAborts()
	runMission()
end

local function onReturn(player: Player)
	if not isCrew(player) or not canReturn then
		return
	end
	canReturn = false

	task.spawn(function()
		fadeCrew("out", 0.7)
		task.wait(0.8)
		restoreLighting()
		Workspace.Gravity = Config.Gravity.Earth
		complex.DescentRig:PivotTo(complex.DescentStart)
		setParachute(true)

		local sx = Config.Splashdown.Point.X
		local sz = Config.Splashdown.Point.Z

		if #crew <= 1 then
			-- Solo: ride the parachute down.
			local hum = humanoidOf(crew[1])
			if hum then
				hum.Sit = false
				task.wait(0.05)
				complex.DescentSeat:Sit(hum)
			end
			fadeCrew("in", 0.8)
			notifyCrew("🔥 Re-entry! Parachute deployed — splashing down.")
			local startY = Config.Splashdown.StartHeight
			local dur = Config.Splashdown.DescentSeconds
			local t = 0
			while t < dur do
				local dt = task.wait()
				t += dt
				if not inFlight then
					return
				end
				local f = math.clamp(t / dur, 0, 1)
				local y = startY + (2 - startY) * f
				local sway = math.sin(t * 1.4) * 7 * (1 - f)
				complex.DescentRig:PivotTo(CFrame.new(sx + sway, y, sz))
			end
		else
			-- Crew: set down together at the splashdown point.
			notifyCrew("🔥 Re-entry — splashing down!")
			complex.DescentRig:PivotTo(CFrame.new(sx, 2, sz))
			for i, p in crew do
				local hum = humanoidOf(p)
				if not hum then
					continue
				end
				if i == 1 then
					complex.DescentSeat:Sit(hum)
				else
					hum.Sit = false
					if p.Character then
						p.Character:PivotTo(CFrame.new(sx + (i - 2) * 4 - 2, 4, sz + 6))
					end
				end
			end
			task.wait(1)
			fadeCrew("in", 0.9)
		end

		setParachute(false)
		notifyCrew("🌊 Splashdown! You're floating safely — call for pickup.")
		awaitingRescue = true
		for _, p in crew do
			rescuePrompt:FireClient(p, true)
		end
	end)
end

function LaunchSystem.requestRescue(player: Player)
	if not isCrew(player) or not awaitingRescue then
		return
	end
	awaitingRescue = false
	local members = table.clone(crew)
	for _, p in members do
		rescuePrompt:FireClient(p, false)
	end
	notifyCrew("🚤 Rescue boats dispatched!")

	task.spawn(function()
		local target = complex.DescentRig:GetPivot().Position
		local boat = WorldBuilder.makeBoat(Vector3.new(Config.Rescue.ShoreX, 1, Config.Splashdown.Point.Z))
		local from = boat:GetPivot()
		local to = CFrame.new(target.X - 9, 1, target.Z)
		local dur = Config.Rescue.BoatSpeedSeconds
		local t = 0
		while t < dur do
			local dt = task.wait()
			t += dt
			if not inFlight then
				boat:Destroy()
				return
			end
			boat:PivotTo(from:Lerp(to, math.clamp(t / dur, 0, 1)))
		end

		notifyCrew("🪝 Pulling you aboard...")
		task.wait(1.2)
		for _, p in members do
			screen:FireClient(p, "out", 0.6)
		end
		task.wait(0.7)
		for _, p in members do
			p:LoadCharacter()
		end
		boat:Destroy()
		endFlight()
		for _, p in members do
			screen:FireClient(p, "in", 0.8)
			notify:FireClient(p, "✅ Rescued! Welcome back to the Cape.")
		end
	end)
end

local function onCycleDestination(player: Player)
	if inFlight or rollingOut then
		notify:FireClient(player, "Can't change the flight plan mid-mission.")
		return
	end
	local cur = complex.FlightConsole:GetAttribute("Dest") or "EarthOrbit"
	local idx = table.find(Config.Destinations, cur) or 1
	local nextDest = Config.Destinations[(idx % #Config.Destinations) + 1]
	complex.FlightConsole:SetAttribute("Dest", nextDest)
	complex.FlightLabel.Text = "Destination: " .. labelFor(nextDest)
	notify:FireClient(player, "🧭 Destination set: " .. labelFor(nextDest))
end

local function onDrive(player: Player)
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp then
		return
	end
	hrp.CFrame = complex.RoverSeat.CFrame * CFrame.new(0, 2, 0)
end

local function artemisUnlocked(): boolean
	-- Always available in Studio so you can test it (solo or with local test players).
	if RunService:IsStudio() then
		return true
	end
	return game.PrivateServerOwnerId ~= 0 and #Players:GetPlayers() >= 2
end

local function updateArtemisSign()
	if not complex then
		return
	end
	complex.ArtemisSign.Text = if artemisUnlocked()
		then "🚀 ARTEMIS — crew of 4 — board & LAUNCH!"
		else "🔒 ARTEMIS — needs a free private server (2+ players)"
end

local function onArtemisBoard(player: Player)
	if inFlight then
		notify:FireClient(player, "🚀 A mission is underway — stand by.")
		return
	end
	if not artemisUnlocked() then
		notify:FireClient(player, "🔒 Artemis unlocks in a FREE private server with 2+ players.")
		return
	end
	if not player:GetAttribute("HasSuit") then
		notify:FireClient(player, "🚫 Suit up before boarding Artemis.")
		return
	end
	local hum = humanoidOf(player)
	if not hum then
		return
	end
	for _, s in complex.ArtemisSeats do
		if not s.Occupant then
			s:Sit(hum)
			notify:FireClient(player, "🧑‍🚀 Boarded Artemis. When the crew's ready, hold LAUNCH (G) up top.")
			return
		end
	end
	notify:FireClient(player, "Artemis is full (4 crew).")
end

local function onArtemisLaunch(player: Player)
	if inFlight then
		notify:FireClient(player, "🚀 A mission is already underway.")
		return
	end
	if not artemisUnlocked() then
		notify:FireClient(player, "🔒 Artemis is locked.")
		return
	end
	local gathered: { Player } = {}
	for _, s in complex.ArtemisSeats do
		local occupant = s.Occupant
		if occupant then
			local p = Players:GetPlayerFromCharacter(occupant.Parent)
			if p then
				table.insert(gathered, p)
			end
		end
	end
	if #gathered == 0 then
		notify:FireClient(player, "No crew aboard Artemis yet — board first (E).")
		return
	end
	crew = gathered
	missionModel = complex.Artemis
	missionEngineFX = complex.ArtemisEngineFX
	missionResetCF = complex.ArtemisStart
	missionDest = "Moon" -- Artemis is the crewed Moon mission
	inFlight = true
	connectAborts()
	runMission()
end

function LaunchSystem.start(complexRef: any)
	complex = complexRef
	complex.OrbitReturnPrompt.Triggered:Connect(onReturn)
	complex.SurfaceReturnPrompt.Triggered:Connect(onReturn)
	complex.FlightCyclePrompt.Triggered:Connect(onCycleDestination)
	complex.RoverDrivePrompt.Triggered:Connect(onDrive)
	complex.RolloutPrompt.Triggered:Connect(function(player: Player)
		LaunchSystem.beginRollout(player)
	end)
	complex.ArtemisBoardPrompt.Triggered:Connect(onArtemisBoard)
	complex.ArtemisLaunchPrompt.Triggered:Connect(onArtemisLaunch)

	rescue.OnServerEvent:Connect(function(player: Player)
		LaunchSystem.requestRescue(player)
	end)

	Players.PlayerAdded:Connect(updateArtemisSign)
	Players.PlayerRemoving:Connect(updateArtemisSign)
	updateArtemisSign()
	refreshMonitor()

	-- Kinematic rover driving while a player occupies the seat.
	RunService.Heartbeat:Connect(function(dt: number)
		local seat = complex.RoverSeat
		if not seat.Occupant then
			return
		end
		local throttle = seat.ThrottleFloat
		local steer = seat.SteerFloat
		if throttle == 0 and steer == 0 then
			return
		end
		local turn = -steer * Config.Rover.TurnRate * dt
		local fwd = throttle * Config.Rover.Speed * dt
		complex.Rover:PivotTo(complex.Rover:GetPivot() * CFrame.Angles(0, turn, 0) * CFrame.new(0, 0, -fwd))
	end)
end

return LaunchSystem
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">RocketBoarding</string>
            <string name="Source"><![CDATA[--!strict
-- Boarding gate: the rocket's prompt seats the player and kicks off the launch,
-- but only if they're suited up and no flight is already underway.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)

local RocketBoarding = {}

local notify = Remotes.event("Notify")

function RocketBoarding.start(complex: any, launchSystem: any)
	local prompt: ProximityPrompt = complex.BoardPrompt
	local seat: Seat = complex.RocketSeat

	prompt.Triggered:Connect(function(player: Player)
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			return
		end
		if not player:GetAttribute("HasSuit") then
			notify:FireClient(player, "🚫 No suit, no launch — put on a space suit first!")
			return
		end
		if launchSystem.isBusy() then
			notify:FireClient(player, "🚀 A launch is in progress — wait for the astronaut to return.")
			return
		end
		if not launchSystem.isReady() then
			notify:FireClient(player, "🚧 The rocket isn't on the pad yet — roll it out from the Vehicle Assembly Building first.")
			return
		end
		seat:Sit(humanoid)
		launchSystem.beginCountdown(player)
	end)
end

return RocketBoarding
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">ServerCapacity</string>
            <string name="Source"><![CDATA[--!strict
-- Sets how many players a server holds, based on whether it's a private server.
--   * Public / normal server      → solo (Config.Servers.PublicMax, default 1)
--   * Player-owned private server  → Config.Servers.PrivateMax (default 5)
--
-- `game.PrivateServerOwnerId` is the UserId of the private server's owner, or 0 for a
-- public server (also 0 in Studio playtests, so testing behaves like a public server).
--
-- NOTE: the place's MaxPlayers (set to 5 in default.project.json) is the ceiling the
-- matchmaker uses; runtime can lower it but not raise it past that. And making private
-- servers FREE is a toggle in the experience settings — see the README.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local ServerCapacity = {}

function ServerCapacity.apply()
	local isPrivate = game.PrivateServerOwnerId ~= 0
	Players.MaxPlayers = if isPrivate then Config.Servers.PrivateMax else Config.Servers.PublicMax
	print(`[space_man] {if isPrivate then "PRIVATE server" else "PUBLIC server"} — max players: {Players.MaxPlayers}`)
end

return ServerCapacity
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">SuitSystem</string>
            <string name="Source"><![CDATA[--!strict
-- Suit-up gate: triggering the Suit Station prompt equips a space suit
-- (helmet + life-support pack) on the player's character and flags them as
-- suited. The suit is lost on respawn, so they must suit up each life.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local SuitSystem = {}

local notify = Remotes.event("Notify")

local function weld(a: BasePart, b: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = a
end

local function applySuit(character: Model)
	local head = character:FindFirstChild("Head") :: BasePart?
	if head and not character:FindFirstChild("SM_Helmet") then
		local helmet = Instance.new("Part")
		helmet.Name = "SM_Helmet"
		helmet.Shape = Enum.PartType.Ball
		helmet.Size = head.Size * 1.7
		helmet.Color = Config.Suit.HelmetColor
		helmet.Material = Enum.Material.Glass
		helmet.Transparency = 0.35
		helmet.CanCollide = false
		helmet.Massless = true
		helmet.CFrame = head.CFrame
		helmet.Parent = character
		weld(helmet, head)
	end

	local torso = (character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")) :: BasePart?
	if torso and not character:FindFirstChild("SM_Pack") then
		local pack = Instance.new("Part")
		pack.Name = "SM_Pack"
		pack.Size = Vector3.new(1.6, 2, 0.8)
		pack.Color = Config.Suit.SuitColor
		pack.Material = Enum.Material.Metal
		pack.CanCollide = false
		pack.Massless = true
		pack.CFrame = torso.CFrame * CFrame.new(0, 0.2, 0.85)
		pack.Parent = character
		weld(pack, torso)
	end
end

local function trackPlayer(player: Player)
	player:SetAttribute("HasSuit", false)
	player.CharacterAdded:Connect(function()
		player:SetAttribute("HasSuit", false)
	end)
end

function SuitSystem.start(complex: any)
	local prompt: ProximityPrompt = complex.SuitPrompt
	prompt.Triggered:Connect(function(player: Player)
		local character = player.Character
		if not character then
			return
		end
		if player:GetAttribute("HasSuit") then
			notify:FireClient(player, "You're already suited up.")
			return
		end
		applySuit(character)
		player:SetAttribute("HasSuit", true)
		notify:FireClient(player, "🧑‍🚀 Space suit on — head to the rocket!")
	end)

	Players.PlayerAdded:Connect(trackPlayer)
	for _, player in Players:GetPlayers() do
		trackPlayer(player)
	end
end

return SuitSystem
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- Builds the launch complex AND the orbit scene out of Parts at runtime, so the
-- whole environment lives in version control. The rocket is an original two-stage
-- orbital design (engine cluster, grid fins, interstage, second stage, fairing).
-- Swap these placeholders for nicer models in Studio later — systems only need the
-- named references back.

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local WorldBuilder = {}

export type Complex = {
	Model: Model,
	Rocket: Model,
	RocketSeat: Seat,
	RocketStart: CFrame,
	BoardPrompt: ProximityPrompt,
	EngineFX: BasePart,
	SuitStation: BasePart,
	SuitPrompt: ProximityPrompt,
	OrbitSeat: Seat,
	OrbitReturnPrompt: ProximityPrompt,
	Satellite: Model,
	DescentRig: Model,
	DescentSeat: Seat,
	DescentStart: CFrame,
	DescentParked: CFrame,
	SurfaceGround: BasePart,
	SurfaceSpawn: CFrame,
	Rover: Model,
	RoverSeat: VehicleSeat,
	RoverDrivePrompt: ProximityPrompt,
	SurfaceReturnPrompt: ProximityPrompt,
	FlightConsole: BasePart,
	FlightLabel: TextLabel,
	FlightCyclePrompt: ProximityPrompt,
	Crawler: Model,
	RocketVAB: CFrame,
	CrawlerVAB: CFrame,
	CrawlerPad: CFrame,
	RolloutPrompt: ProximityPrompt,
	MonitorLabel: TextLabel,
	OrbitDeck: BasePart,
	Artemis: Model,
	ArtemisSeats: { Seat },
	ArtemisBoardPrompt: ProximityPrompt,
	ArtemisLaunchPrompt: ProximityPrompt,
	ArtemisEngineFX: BasePart,
	ArtemisStart: CFrame,
	ArtemisSign: TextLabel,
}

local CONCRETE = Color3.fromRGB(150, 150, 158)
local WHITE = Color3.fromRGB(240, 242, 248)
local DARK = Color3.fromRGB(45, 48, 58)
local GREY = Color3.fromRGB(90, 92, 100)
local NOZZLE = Color3.fromRGB(70, 72, 80)
local ACCENT = Color3.fromRGB(70, 130, 220)

local function part(parent: Instance, props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = parent
	return p
end

-- Vertical cylinder (Roblox cylinders run along their X axis, so we stand them up).
local function vcyl(parent: Instance, name: string, x: number, z: number, y: number, height: number, dia: number, color: Color3, material: Enum.Material?): Part
	return part(parent, {
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, dia, dia),
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
		CFrame = CFrame.new(x, y, z) * CFrame.Angles(0, 0, math.rad(90)),
	})
end

local function block(parent: Instance, name: string, cframe: CFrame, size: Vector3, color: Color3, material: Enum.Material?): Part
	return part(parent, {
		Name = name,
		Size = size,
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
		CFrame = cframe,
	})
end

local function nameTag(adornee: BasePart, text: string, height: number)
	local bb = Instance.new("BillboardGui")
	bb.Name = "NameTag"
	bb.Size = UDim2.new(0, 280, 0, 54)
	bb.StudsOffsetWorldSpace = Vector3.new(0, height, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 600

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.Text = text
	label.TextColor3 = WHITE
	label.TextStrokeTransparency = 0.4
	label.TextScaled = true
	label.Parent = bb

	bb.Adornee = adornee
	bb.Parent = adornee
end

local function buildRocket(parent: Instance, base: Vector3): (Model, Seat, ProximityPrompt, BasePart)
	local bx, bz = base.X, base.Z
	local rocket = Instance.new("Model")
	rocket.Name = "Rocket"

	-- First stage + engine skirt + accent stripe
	vcyl(rocket, "Stage1", bx, bz, base.Y + 16, 30, 7, WHITE)
	vcyl(rocket, "EngineSkirt", bx, bz, base.Y + 2.5, 3, 7.3, DARK)
	vcyl(rocket, "Stripe", bx, bz, base.Y + 23, 1.5, 7.12, ACCENT)

	-- Engine nozzles (centre + ring of four)
	vcyl(rocket, "Nozzle", bx, bz, base.Y + 2.2, 2.4, 1.8, NOZZLE)
	for i = 0, 3 do
		local a = math.rad(i * 90)
		vcyl(rocket, "Nozzle", bx + math.cos(a) * 2, bz + math.sin(a) * 2, base.Y + 2.2, 2.4, 1.6, NOZZLE)
	end

	-- Base fins
	for i = 0, 3 do
		local a = math.rad(i * 90)
		block(rocket, "Fin", CFrame.new(bx + math.cos(a) * 3.6, base.Y + 4.5, bz + math.sin(a) * 3.6) * CFrame.Angles(0, -a, 0), Vector3.new(0.6, 7, 3), DARK)
	end

	-- Grid fins near the top of the first stage
	for i = 0, 3 do
		local a = math.rad(i * 90 + 45)
		block(rocket, "GridFin", CFrame.new(bx + math.cos(a) * 3.8, base.Y + 26, bz + math.sin(a) * 3.8) * CFrame.Angles(0, -a, 0), Vector3.new(0.3, 2.6, 2.6), GREY)
	end

	-- Interstage + second stage
	vcyl(rocket, "Interstage", bx, bz, base.Y + 32, 2, 7, DARK)
	vcyl(rocket, "Stage2", bx, bz, base.Y + 39, 12, 6.4, WHITE)

	-- Tapered payload fairing (semi-transparent so the rover payload shows) + nose tip
	local f1 = vcyl(rocket, "Fairing", bx, bz, base.Y + 46.5, 3, 6, WHITE)
	local f2 = vcyl(rocket, "Fairing", bx, bz, base.Y + 49, 2.5, 4.5, WHITE)
	local f3 = vcyl(rocket, "Fairing", bx, bz, base.Y + 51, 1.5, 3, WHITE)
	f1.Transparency = 0.3
	f2.Transparency = 0.3
	f3.Transparency = 0.3
	part(rocket, {
		Name = "Tip",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(3, 3, 3),
		Color = WHITE,
		Material = Enum.Material.SmoothPlastic,
		CFrame = CFrame.new(bx, base.Y + 52.2, bz),
	})

	-- Stowed rover payload sitting in the top of the rocket (the one you deploy on the surface)
	block(rocket, "PayloadDeck", CFrame.new(bx, base.Y + 45.4, bz), Vector3.new(4.2, 0.4, 4.2), Color3.fromRGB(60, 63, 72))
	block(rocket, "PayloadRover", CFrame.new(bx, base.Y + 46.5, bz), Vector3.new(3.4, 1.6, 3.6), Color3.fromRGB(220, 200, 80))
	for i = 0, 3 do
		local wx = if i % 2 == 0 then 1.4 else -1.4
		local wz = if i < 2 then 1.4 else -1.4
		part(rocket, {
			Name = "PayloadWheel",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.7, 1.4, 1.4),
			Color = Color3.fromRGB(40, 42, 48),
			CFrame = CFrame.new(bx + wx, base.Y + 45.9, bz + wz),
		})
	end

	-- Capsule window
	block(rocket, "Window", CFrame.new(bx, base.Y + 39, bz + 3.25), Vector3.new(1.4, 1.4, 0.25), Color3.fromRGB(40, 60, 95))

	-- Pilot seat, up inside the capsule
	local seat = Instance.new("Seat")
	seat.Name = "PilotSeat"
	seat.Anchored = true
	seat.CanCollide = false
	seat.Transparency = 1
	seat.Size = Vector3.new(3, 1, 3)
	seat.CFrame = CFrame.new(bx, base.Y + 38, bz)
	seat.Parent = rocket

	-- Boarding prompt down at the base where players walk up
	local skirt = rocket:FindFirstChild("EngineSkirt") :: BasePart
	local boardPrompt = Instance.new("ProximityPrompt")
	boardPrompt.Name = "BoardPrompt"
	boardPrompt.ActionText = "Enter Rocket"
	boardPrompt.ObjectText = "Rocket"
	boardPrompt.HoldDuration = 0.5
	boardPrompt.RequiresLineOfSight = false
	boardPrompt.MaxActivationDistance = Config.Rocket.PromptDistance
	boardPrompt.Parent = skirt

	-- Engine effects host at the very base
	local engineFX = part(rocket, {
		Name = "EngineFX",
		Size = Vector3.new(1, 1, 1),
		Transparency = 1,
		CanCollide = false,
		CFrame = CFrame.new(bx, base.Y + 0.6, bz),
	})

	local flame = Instance.new("ParticleEmitter")
	flame.Name = "Flame"
	flame.Enabled = false
	flame.EmissionDirection = Enum.NormalId.Bottom
	flame.Rate = 140
	flame.Lifetime = NumberRange.new(0.3, 0.7)
	flame.Speed = NumberRange.new(25, 45)
	flame.SpreadAngle = Vector2.new(12, 12)
	flame.LightEmission = 1
	flame.Color = ColorSequence.new(Color3.fromRGB(255, 190, 70), Color3.fromRGB(255, 90, 25))
	flame.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 6) })
	flame.Parent = engineFX

	local smoke = Instance.new("ParticleEmitter")
	smoke.Name = "Smoke"
	smoke.Enabled = false
	smoke.EmissionDirection = Enum.NormalId.Bottom
	smoke.Rate = 70
	smoke.Lifetime = NumberRange.new(1, 2)
	smoke.Speed = NumberRange.new(12, 22)
	smoke.SpreadAngle = Vector2.new(25, 25)
	smoke.Color = ColorSequence.new(Color3.fromRGB(225, 225, 225))
	smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 4), NumberSequenceKeypoint.new(1, 11) })
	smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1) })
	smoke.Parent = engineFX

	local light = Instance.new("PointLight")
	light.Name = "EngineLight"
	light.Enabled = false
	light.Brightness = 6
	light.Range = 32
	light.Color = Color3.fromRGB(255, 170, 80)
	light.Parent = engineFX

	rocket.PrimaryPart = rocket:FindFirstChild("Stage1") :: BasePart
	rocket.Parent = parent
	return rocket, seat, boardPrompt, engineFX
end

local function buildOrbitScene(parent: Instance, center: Vector3): (Seat, ProximityPrompt, Model, BasePart)
	local cx, cy, cz = center.X, center.Y, center.Z
	local earthCenter = Vector3.new(cx, cy - 520, cz)

	part(parent, {
		Name = "Earth",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(700, 700, 700),
		Position = earthCenter,
		Color = Color3.fromRGB(38, 86, 162),
		Material = Enum.Material.SmoothPlastic,
	})
	part(parent, {
		Name = "Atmosphere",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(744, 744, 744),
		Position = earthCenter,
		Color = Color3.fromRGB(135, 180, 255),
		Material = Enum.Material.SmoothPlastic,
		Transparency = 0.62,
		CanCollide = false,
	})

	local dirs = {
		Vector3.new(1, 0.35, 0.2),
		Vector3.new(-0.6, 0.5, 0.5),
		Vector3.new(0.2, -0.45, 0.85),
		Vector3.new(-0.35, -0.6, -0.55),
		Vector3.new(0.55, 0.25, -0.75),
	}
	for i, d in dirs do
		local size = 150 + i * 12
		part(parent, {
			Name = "Continent",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(size, size, size),
			Position = earthCenter + d.Unit * 330,
			Color = Color3.fromRGB(72, 148, 84),
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
		})
	end

	-- Re-entry capsule the player rides in orbit
	vcyl(parent, "Capsule", cx, cz, cy, 3, 7, Color3.fromRGB(205, 210, 218))
	part(parent, {
		Name = "CapsuleDome",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(7, 7, 7),
		Position = Vector3.new(cx, cy + 2.4, cz),
		Color = Color3.fromRGB(205, 210, 218),
		Material = Enum.Material.SmoothPlastic,
	})

	local orbitSeat = Instance.new("Seat")
	orbitSeat.Name = "OrbitSeat"
	orbitSeat.Anchored = true
	orbitSeat.CanCollide = false
	orbitSeat.Transparency = 1
	orbitSeat.Size = Vector3.new(3, 1, 3)
	orbitSeat.CFrame = CFrame.new(cx, cy + 0.5, cz)
	orbitSeat.Parent = parent

	local capsulePart = parent:FindFirstChild("Capsule") :: BasePart
	local returnPrompt = Instance.new("ProximityPrompt")
	returnPrompt.Name = "OrbitReturnPrompt"
	returnPrompt.ActionText = "Return to Earth"
	returnPrompt.ObjectText = "Re-entry Capsule"
	returnPrompt.HoldDuration = 1
	returnPrompt.RequiresLineOfSight = false
	returnPrompt.MaxActivationDistance = 18
	returnPrompt.Parent = capsulePart

	-- Pre-placed satellite (scenery); player-deployed ones are spawned at runtime.
	local satellite = WorldBuilder.makeSatellite(Vector3.new(cx + 26, cy + 5, cz))

	-- Standing deck for extra crew members (the lone OrbitSeat only seats one).
	local deck = part(parent, {
		Name = "OrbitDeck",
		Size = Vector3.new(16, 1, 16),
		Position = Vector3.new(cx, cy - 1, cz),
		Color = Color3.fromRGB(70, 74, 82),
		Material = Enum.Material.DiamondPlate,
	})

	return orbitSeat, returnPrompt, satellite, deck
end

local function buildDescentRig(parent: Instance, base: Vector3): (Model, Seat)
	local bx, bz = base.X, base.Z
	local rig = Instance.new("Model")
	rig.Name = "DescentRig"

	-- Axis-aligned root so we can re-orient the rig safely while descending.
	local root = part(rig, {
		Name = "Root",
		Size = Vector3.new(1, 1, 1),
		Transparency = 1,
		CanCollide = false,
		CFrame = CFrame.new(bx, base.Y + 2, bz),
	})

	vcyl(rig, "Capsule", bx, bz, base.Y + 1.5, 3, 7, Color3.fromRGB(60, 64, 72))
	vcyl(rig, "Shield", bx, bz, base.Y + 0.2, 0.8, 7.4, Color3.fromRGB(34, 31, 29))
	part(rig, {
		Name = "CapsuleDome",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(7, 7, 7),
		Position = Vector3.new(bx, base.Y + 3.9, bz),
		Color = Color3.fromRGB(70, 74, 82),
		Material = Enum.Material.SmoothPlastic,
	})

	local seat = Instance.new("Seat")
	seat.Name = "DescentSeat"
	seat.Anchored = true
	seat.CanCollide = false
	seat.Transparency = 1
	seat.Size = Vector3.new(3, 1, 3)
	seat.CFrame = CFrame.new(bx, base.Y + 2, bz)
	seat.Parent = rig

	local chute = Instance.new("Model")
	chute.Name = "Parachute"
	chute.Parent = rig

	local canopy = part(chute, {
		Name = "Canopy",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(46, 18, 46),
		Position = Vector3.new(bx, base.Y + 34, bz),
		Color = Color3.fromRGB(232, 96, 52),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		Transparency = 0.05,
	})
	canopy:SetAttribute("Vis", 0.05)

	for i = 0, 5 do
		local a = math.rad(i * 60)
		local rim = Vector3.new(bx + math.cos(a) * 19, base.Y + 30, bz + math.sin(a) * 19)
		local cap = Vector3.new(bx + math.cos(a) * 2.5, base.Y + 6, bz + math.sin(a) * 2.5)
		local mid = (rim + cap) / 2
		local line = part(chute, {
			Name = "Line",
			Size = Vector3.new(0.18, 0.18, (rim - cap).Magnitude),
			Color = Color3.fromRGB(240, 240, 245),
			CanCollide = false,
			CFrame = CFrame.lookAt(mid, cap),
		})
		line:SetAttribute("Vis", 0)
	end

	rig.PrimaryPart = root
	rig.Parent = parent
	return rig, seat
end

local function buildRover(parent: Instance, position: Vector3): (Model, VehicleSeat, ProximityPrompt)
	local p = position
	local rover = Instance.new("Model")
	rover.Name = "Rover"

	local chassis = part(rover, {
		Name = "Chassis",
		Size = Vector3.new(6, 1.4, 9),
		Position = p,
		Color = Color3.fromRGB(220, 200, 80),
		Material = Enum.Material.Metal,
	})
	part(rover, {
		Name = "Body",
		Size = Vector3.new(5, 1.6, 5),
		Position = p + Vector3.new(0, 1.4, -1.2),
		Color = Color3.fromRGB(235, 238, 244),
	})
	part(rover, {
		Name = "Solar",
		Size = Vector3.new(5.4, 0.2, 4),
		Position = p + Vector3.new(0, 2.3, -1.2),
		Color = Color3.fromRGB(40, 60, 120),
	})

	for i = 0, 3 do
		local wx = if i % 2 == 0 then 3.2 else -3.2
		local wz = if i < 2 then 3 else -3
		part(rover, {
			Name = "Wheel",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1.2, 3, 3),
			Color = Color3.fromRGB(40, 42, 48),
			CFrame = CFrame.new(p.X + wx, p.Y - 0.6, p.Z + wz),
		})
	end

	vcyl(rover, "Mast", p.X - 1.6, p.Z - 1.2, p.Y + 2.8, 2.4, 0.3, Color3.fromRGB(120, 122, 130))

	local seat = Instance.new("VehicleSeat")
	seat.Name = "RoverSeat"
	seat.Anchored = true
	seat.Size = Vector3.new(3, 1, 3)
	seat.Position = p + Vector3.new(0, 1.5, 1.6)
	seat.Color = Color3.fromRGB(55, 58, 68)
	seat.MaxSpeed = 0
	seat.Torque = 0
	seat.HeadsUpDisplay = false
	seat.Parent = rover

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "RoverDrivePrompt"
	prompt.ActionText = "Drive Rover"
	prompt.ObjectText = "Rover"
	prompt.HoldDuration = 0.3
	prompt.RequiresLineOfSight = false
	prompt.MaxActivationDistance = 12
	prompt.Parent = chassis

	rover.PrimaryPart = chassis
	rover.Parent = parent
	return rover, seat, prompt
end

local function buildSurface(parent: Instance, center: Vector3): (BasePart, CFrame, Model, VehicleSeat, ProximityPrompt, ProximityPrompt)
	local cx, cy, cz = center.X, center.Y, center.Z

	local ground = part(parent, {
		Name = "SurfaceGround",
		Size = Vector3.new(1200, 4, 1200),
		Position = Vector3.new(cx, cy - 2, cz),
		Color = Color3.fromRGB(132, 132, 138),
		Material = Enum.Material.Sand,
	})

	local spots = {
		Vector3.new(40, 30), Vector3.new(-50, 60), Vector3.new(70, -40),
		Vector3.new(-30, -70), Vector3.new(95, 55), Vector3.new(-80, -20),
	}
	for i, s in spots do
		local r = 4 + (i % 3) * 3
		part(parent, {
			Name = "Rock",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(r * 2, r * 2, r * 2),
			Position = Vector3.new(cx + s.X, cy + r * 0.4, cz + s.Y),
			Color = Color3.fromRGB(110, 110, 116),
			Material = Enum.Material.Slate,
		})
	end

	part(parent, {
		Name = "BaseHab",
		Size = Vector3.new(16, 8, 12),
		Position = Vector3.new(cx - 34, cy + 4, cz - 22),
		Color = Color3.fromRGB(225, 228, 235),
		Material = Enum.Material.Metal,
	})
	part(parent, {
		Name = "BaseDome",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(26, 26, 26),
		Position = Vector3.new(cx - 16, cy + 3, cz - 22),
		Color = Color3.fromRGB(205, 212, 222),
		Material = Enum.Material.Glass,
		Transparency = 0.3,
	})

	-- Lander / ascent stage (carries you home)
	local landerPos = Vector3.new(cx, cy, cz - 6)
	part(parent, {
		Name = "LanderBase",
		Size = Vector3.new(9, 4, 9),
		Position = landerPos + Vector3.new(0, 3, 0),
		Color = Color3.fromRGB(184, 150, 60),
		Material = Enum.Material.Metal,
	})
	for i = 0, 3 do
		local a = math.rad(i * 90 + 45)
		block(parent, "LanderLeg", CFrame.new(cx + math.cos(a) * 6, cy + 1.5, cz - 6 + math.sin(a) * 6) * CFrame.Angles(math.rad(20), -a, 0), Vector3.new(0.6, 6, 0.6), Color3.fromRGB(90, 92, 100))
	end
	local landerCap = part(parent, {
		Name = "LanderCapsule",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(6, 6, 6),
		Position = landerPos + Vector3.new(0, 7, 0),
		Color = Color3.fromRGB(200, 205, 212),
		Material = Enum.Material.SmoothPlastic,
	})
	local returnPrompt = Instance.new("ProximityPrompt")
	returnPrompt.Name = "SurfaceReturnPrompt"
	returnPrompt.ActionText = "Return to Earth"
	returnPrompt.ObjectText = "Ascent Stage"
	returnPrompt.HoldDuration = 1
	returnPrompt.RequiresLineOfSight = false
	returnPrompt.MaxActivationDistance = 14
	returnPrompt.Parent = landerCap

	local rover, roverSeat, drivePrompt = buildRover(parent, Vector3.new(cx + 16, cy + 2.1, cz + 6))
	local spawnCF = CFrame.new(Vector3.new(cx + 6, cy + 4, cz + 8), Vector3.new(cx + 16, cy + 2, cz + 6))

	return ground, spawnCF, rover, roverSeat, drivePrompt, returnPrompt
end

function WorldBuilder.makeSatellite(position: Vector3): Model
	local satellite = Instance.new("Model")
	satellite.Name = "Satellite"
	local satBody = part(satellite, {
		Name = "Body",
		Size = Vector3.new(3, 3, 4),
		Position = position,
		Color = Color3.fromRGB(188, 194, 205),
		Material = Enum.Material.Metal,
	})
	part(satellite, {
		Name = "Panel",
		Size = Vector3.new(10, 0.2, 4),
		Position = position + Vector3.new(6.5, 0, 0),
		Color = Color3.fromRGB(40, 60, 120),
	})
	part(satellite, {
		Name = "Panel",
		Size = Vector3.new(10, 0.2, 4),
		Position = position - Vector3.new(6.5, 0, 0),
		Color = Color3.fromRGB(40, 60, 120),
	})
	vcyl(satellite, "Mast", position.X, position.Z, position.Y + 3.2, 3, 0.4, GREY)
	part(satellite, {
		Name = "Dish",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(2.4, 2.4, 2.4),
		Position = position + Vector3.new(0, 4.6, 0),
		Color = Color3.fromRGB(220, 222, 228),
	})
	satellite.PrimaryPart = satBody
	satellite.Parent = Workspace
	return satellite
end

local function buildCrawler(parent: Instance, pos: Vector3): Model
	local crawler = Instance.new("Model")
	crawler.Name = "Crawler"
	local deck = part(crawler, {
		Name = "Deck",
		Size = Vector3.new(20, 1.2, 26),
		Position = pos,
		Color = Color3.fromRGB(70, 72, 80),
		Material = Enum.Material.DiamondPlate,
	})
	for _, x in { -8, 8 } do
		part(crawler, {
			Name = "Tread",
			Size = Vector3.new(3, 1.8, 26),
			Position = pos + Vector3.new(x, -0.5, 0),
			Color = Color3.fromRGB(34, 36, 42),
			Material = Enum.Material.Metal,
		})
	end
	crawler.PrimaryPart = deck
	crawler.Parent = parent
	return crawler
end

local function buildArtemis(parent: Instance, base: Vector3): (Model, { Seat }, ProximityPrompt, ProximityPrompt, BasePart, TextLabel)
	local bx, bz = base.X, base.Z
	local artemis = Instance.new("Model")
	artemis.Name = "Artemis"
	local ORANGE = Color3.fromRGB(196, 98, 40)

	-- Core stage + skirt + engine cluster
	vcyl(artemis, "Core", bx, bz, base.Y + 17, 34, 8, ORANGE)
	vcyl(artemis, "CoreSkirt", bx, bz, base.Y + 2.5, 3, 8.3, DARK)
	for i = 0, 3 do
		local a = math.rad(i * 90)
		vcyl(artemis, "Nozzle", bx + math.cos(a) * 2.2, bz + math.sin(a) * 2.2, base.Y + 2, 2.6, 1.8, NOZZLE)
	end

	-- Two solid boosters
	for _, sx in { -6.4, 6.4 } do
		vcyl(artemis, "Booster", bx + sx, bz, base.Y + 14, 28, 4, WHITE)
		vcyl(artemis, "BoosterNose", bx + sx, bz, base.Y + 29.5, 3, 4, Color3.fromRGB(210, 80, 60))
		vcyl(artemis, "BoosterNozzle", bx + sx, bz, base.Y + 1.6, 2, 2.8, NOZZLE)
	end

	-- Service module + tapered Orion-style capsule
	vcyl(artemis, "Service", bx, bz, base.Y + 36, 4, 7, Color3.fromRGB(150, 152, 160))
	local capBase = vcyl(artemis, "Capsule", bx, bz, base.Y + 40, 4, 7.6, WHITE)
	vcyl(artemis, "Capsule", bx, bz, base.Y + 43, 2.5, 5.4, WHITE)
	vcyl(artemis, "Capsule", bx, bz, base.Y + 45, 1.5, 3.4, WHITE)
	part(artemis, {
		Name = "Tip",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(3.4, 3.4, 3.4),
		Color = WHITE,
		Material = Enum.Material.SmoothPlastic,
		CFrame = CFrame.new(bx, base.Y + 46.4, bz),
	})

	-- Four crew seats inside the capsule
	local seats: { Seat } = {}
	for i = 0, 3 do
		local ox = if i % 2 == 0 then -1.6 else 1.6
		local oz = if i < 2 then -1.6 else 1.6
		local s = Instance.new("Seat")
		s.Name = "ArtemisSeat"
		s.Anchored = true
		s.CanCollide = false
		s.Transparency = 1
		s.Size = Vector3.new(2.2, 1, 2.2)
		s.CFrame = CFrame.new(bx + ox, base.Y + 39, bz + oz)
		s.Parent = artemis
		table.insert(seats, s)
	end

	-- Engine effects
	local engineFX = part(artemis, {
		Name = "EngineFX",
		Size = Vector3.new(1, 1, 1),
		Transparency = 1,
		CanCollide = false,
		CFrame = CFrame.new(bx, base.Y + 0.6, bz),
	})
	local flame = Instance.new("ParticleEmitter")
	flame.Name = "Flame"
	flame.Enabled = false
	flame.EmissionDirection = Enum.NormalId.Bottom
	flame.Rate = 200
	flame.Lifetime = NumberRange.new(0.3, 0.8)
	flame.Speed = NumberRange.new(30, 55)
	flame.SpreadAngle = Vector2.new(14, 14)
	flame.LightEmission = 1
	flame.Color = ColorSequence.new(Color3.fromRGB(255, 190, 70), Color3.fromRGB(255, 90, 25))
	flame.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 8) })
	flame.Parent = engineFX
	local smoke = Instance.new("ParticleEmitter")
	smoke.Name = "Smoke"
	smoke.Enabled = false
	smoke.EmissionDirection = Enum.NormalId.Bottom
	smoke.Rate = 90
	smoke.Lifetime = NumberRange.new(1, 2.2)
	smoke.Speed = NumberRange.new(14, 26)
	smoke.SpreadAngle = Vector2.new(28, 28)
	smoke.Color = ColorSequence.new(Color3.fromRGB(225, 225, 225))
	smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 5), NumberSequenceKeypoint.new(1, 14) })
	smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1) })
	smoke.Parent = engineFX
	local light = Instance.new("PointLight")
	light.Name = "EngineLight"
	light.Enabled = false
	light.Brightness = 7
	light.Range = 40
	light.Color = Color3.fromRGB(255, 170, 80)
	light.Parent = engineFX

	-- Board low on the skirt; LAUNCH up by the crew seats (only seated crew can reach it).
	local skirt = artemis:FindFirstChild("CoreSkirt") :: BasePart
	local boardPrompt = Instance.new("ProximityPrompt")
	boardPrompt.Name = "ArtemisBoardPrompt"
	boardPrompt.ActionText = "Board Artemis"
	boardPrompt.ObjectText = "Artemis — crew of 4"
	boardPrompt.HoldDuration = 0.4
	boardPrompt.RequiresLineOfSight = false
	boardPrompt.MaxActivationDistance = 16
	boardPrompt.KeyboardKeyCode = Enum.KeyCode.E
	boardPrompt.Parent = skirt

	local launchPrompt = Instance.new("ProximityPrompt")
	launchPrompt.Name = "ArtemisLaunchPrompt"
	launchPrompt.ActionText = "LAUNCH Crew"
	launchPrompt.ObjectText = "Artemis"
	launchPrompt.HoldDuration = 1
	launchPrompt.RequiresLineOfSight = false
	launchPrompt.MaxActivationDistance = 12
	launchPrompt.KeyboardKeyCode = Enum.KeyCode.G
	launchPrompt.Parent = capBase

	local signGui = Instance.new("BillboardGui")
	signGui.Name = "ArtemisSign"
	signGui.Size = UDim2.new(0, 360, 0, 50)
	signGui.StudsOffsetWorldSpace = Vector3.new(0, 30, 0)
	signGui.AlwaysOnTop = true
	signGui.MaxDistance = 450
	signGui.Adornee = capBase
	local signLabel = Instance.new("TextLabel")
	signLabel.Size = UDim2.fromScale(1, 1)
	signLabel.BackgroundTransparency = 1
	signLabel.Font = Enum.Font.GothamBold
	signLabel.TextColor3 = Color3.fromRGB(255, 210, 120)
	signLabel.TextStrokeTransparency = 0.4
	signLabel.TextScaled = true
	signLabel.Text = "ARTEMIS"
	signLabel.Parent = signGui
	signGui.Parent = capBase

	artemis.PrimaryPart = artemis:FindFirstChild("Core") :: BasePart
	artemis.Parent = parent
	return artemis, seats, boardPrompt, launchPrompt, engineFX, signLabel
end

function WorldBuilder.makeBoat(position: Vector3): Model
	local boat = Instance.new("Model")
	boat.Name = "RescueBoat"
	local hull = part(boat, {
		Name = "Hull",
		Size = Vector3.new(12, 2.5, 5),
		Position = position,
		Color = Color3.fromRGB(185, 60, 55),
		Material = Enum.Material.SmoothPlastic,
	})
	part(boat, {
		Name = "Deck",
		Size = Vector3.new(12, 0.4, 5),
		Position = position + Vector3.new(0, 1.45, 0),
		Color = Color3.fromRGB(220, 222, 228),
	})
	part(boat, {
		Name = "Cabin",
		Size = Vector3.new(4, 2.6, 4),
		Position = position + Vector3.new(-2.5, 2.8, 0),
		Color = Color3.fromRGB(236, 238, 244),
	})
	part(boat, {
		Name = "Beacon",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1, 1, 1),
		Position = position + Vector3.new(-2.5, 4.3, 0),
		Color = Color3.fromRGB(255, 90, 60),
		Material = Enum.Material.Neon,
	})
	boat.PrimaryPart = hull
	boat.Parent = Workspace
	return boat
end

function WorldBuilder.build(): Complex
	local model = Instance.new("Model")
	model.Name = "SpaceMan"
	model.Parent = Workspace

	-- Ground + spawn are static in the place (see default.project.json) so they show
	-- in Studio's Edit view too; the rest of the complex is generated here on Play.
	local suitStation = part(model, {
		Name = "SuitStation",
		Size = Vector3.new(8, 4, 8),
		Position = Vector3.new(16, 2, 62),
		Color = ACCENT,
		Material = Enum.Material.Metal,
	})
	nameTag(suitStation, "🧑‍🚀 SUIT UP", 4)

	local suitPrompt = Instance.new("ProximityPrompt")
	suitPrompt.Name = "SuitPrompt"
	suitPrompt.ActionText = "Put on Space Suit"
	suitPrompt.ObjectText = "Suit Station"
	suitPrompt.HoldDuration = 1
	suitPrompt.RequiresLineOfSight = false
	suitPrompt.MaxActivationDistance = Config.Suit.PromptDistance
	suitPrompt.Parent = suitStation

	local vab = part(model, {
		Name = "VehicleAssemblyBuilding",
		Size = Vector3.new(34, 56, 34),
		Position = Vector3.new(0, 28, 40),
		Color = WHITE,
		Material = Enum.Material.Concrete,
	})
	nameTag(vab, "VEHICLE ASSEMBLY", 30)

	local mc = part(model, {
		Name = "MissionControl",
		Size = Vector3.new(30, 14, 22),
		Position = Vector3.new(-56, 7, 20),
		Color = Color3.fromRGB(208, 210, 216),
		Material = Enum.Material.Concrete,
	})
	nameTag(mc, "MISSION CONTROL", 9)

	part(model, {
		Name = "Crawlerway",
		Size = Vector3.new(16, 0.3, 112),
		Position = Vector3.new(0, 0.15, -16),
		Color = Color3.fromRGB(120, 110, 95),
		Material = Enum.Material.Ground,
	})

	local padCenter = Vector3.new(0, 0.5, -72)
	part(model, {
		Name = "LaunchPad",
		Size = Vector3.new(40, 1, 40),
		Position = padCenter,
		Color = DARK,
		Material = Enum.Material.Slate,
	})

	for i = 0, 3 do
		part(model, {
			Name = "TowerLeg",
			Size = Vector3.new(1, 50, 1),
			Position = Vector3.new(-14 + (i % 2) * 2, 25, -74 + math.floor(i / 2) * 2),
			Color = DARK,
			Material = Enum.Material.Metal,
		})
	end

	local rocket, seat, boardPrompt, engineFX = buildRocket(model, Vector3.new(padCenter.X, 1, padCenter.Z))
	local orbitSeat, orbitReturnPrompt, satellite, orbitDeck = buildOrbitScene(model, Config.Orbit.Center)

	-- Park the rocket at the VAB on a crawler-transporter; it rolls out to the pad later.
	local rocketPad = rocket:GetPivot()
	local rocketVAB = rocketPad + Vector3.new(0, 0, 90)
	rocket:PivotTo(rocketVAB)
	local crawler = buildCrawler(model, Vector3.new(0, 0.6, 18))
	local crawlerVAB = crawler:GetPivot()
	local crawlerPad = crawlerVAB + Vector3.new(0, 0, -90)

	-- Ocean east of the Cape. Prefer real terrain water; fall back to a water-coloured
	-- part if the place has no Terrain object (so this can never crash the build).
	local terrain = Workspace:FindFirstChildOfClass("Terrain")
	if terrain then
		terrain:FillBlock(CFrame.new(Config.Ocean.Center), Config.Ocean.Size, Enum.Material.Water)
	else
		part(model, {
			Name = "Ocean",
			Size = Vector3.new(Config.Ocean.Size.X, 2, Config.Ocean.Size.Z),
			Position = Config.Ocean.Center + Vector3.new(0, 19, 0),
			Color = Color3.fromRGB(40, 96, 150),
			Material = Enum.Material.Glass,
			Transparency = 0.25,
		})
	end

	-- Re-entry capsule + parachute, parked underground until splashdown.
	local descentRig, descentSeat = buildDescentRig(model, Config.Splashdown.Point)
	local descentStart = CFrame.new(Config.Splashdown.Point.X, Config.Splashdown.StartHeight, Config.Splashdown.Point.Z)
	local descentParked = CFrame.new(Config.Splashdown.Point.X, -500, Config.Splashdown.Point.Z)
	descentRig:PivotTo(descentParked)

	-- Surface world (Moon / Mars, recoloured per destination) with the deployable rover.
	local surfaceGround, surfaceSpawn, rover, roverSeat, roverDrivePrompt, surfaceReturnPrompt =
		buildSurface(model, Config.Surface.Center)

	-- Second pad + the Artemis (crewed Moon rocket); unlocked in private servers.
	part(model, {
		Name = "ArtemisPad",
		Size = Vector3.new(40, 1, 40),
		Position = Vector3.new(90, 0.5, -72),
		Color = DARK,
		Material = Enum.Material.Slate,
	})
	local artemis, artemisSeats, artemisBoardPrompt, artemisLaunchPrompt, artemisEngineFX, artemisSign =
		buildArtemis(model, Vector3.new(90, 1, -72))
	local artemisStart = artemis:GetPivot()

	-- Flight-plan console near the pad to pick a destination.
	local flightConsole = part(model, {
		Name = "FlightConsole",
		Size = Vector3.new(6, 3, 2),
		Position = Vector3.new(-16, 1.5, 62),
		Color = Color3.fromRGB(40, 44, 54),
		Material = Enum.Material.Metal,
	})
	flightConsole:SetAttribute("Dest", "EarthOrbit")

	local flightBillboard = Instance.new("BillboardGui")
	flightBillboard.Name = "FlightPlan"
	flightBillboard.Size = UDim2.new(0, 240, 0, 40)
	flightBillboard.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
	flightBillboard.AlwaysOnTop = true
	flightBillboard.MaxDistance = 90
	flightBillboard.Adornee = flightConsole

	local flightLabel = Instance.new("TextLabel")
	flightLabel.Size = UDim2.fromScale(1, 1)
	flightLabel.BackgroundTransparency = 1
	flightLabel.Font = Enum.Font.GothamBold
	flightLabel.TextColor3 = Color3.fromRGB(150, 220, 255)
	flightLabel.TextStrokeTransparency = 0.4
	flightLabel.TextScaled = true
	flightLabel.Text = "Destination: Earth Orbit"
	flightLabel.Parent = flightBillboard
	flightBillboard.Parent = flightConsole

	local flightCyclePrompt = Instance.new("ProximityPrompt")
	flightCyclePrompt.Name = "FlightCyclePrompt"
	flightCyclePrompt.ActionText = "Change Destination"
	flightCyclePrompt.ObjectText = "Flight Plan"
	flightCyclePrompt.HoldDuration = 0.3
	flightCyclePrompt.RequiresLineOfSight = false
	flightCyclePrompt.MaxActivationDistance = 10
	flightCyclePrompt.Parent = flightConsole

	-- Rollout prompt on the VAB (assemble + roll the rocket to the pad).
	local rolloutPrompt = Instance.new("ProximityPrompt")
	rolloutPrompt.Name = "RolloutPrompt"
	rolloutPrompt.ActionText = "Assemble & Roll Out Rocket"
	rolloutPrompt.ObjectText = "Vehicle Assembly Building"
	rolloutPrompt.HoldDuration = 0.5
	rolloutPrompt.RequiresLineOfSight = false
	rolloutPrompt.MaxActivationDistance = 20
	rolloutPrompt.Parent = vab

	-- Mission Control satellite-monitor screen (on the east face of the MC building).
	local screenPart = part(model, {
		Name = "MonitorScreen",
		Size = Vector3.new(0.4, 7, 12),
		Position = Vector3.new(-40.6, 8, 20),
		Color = Color3.fromRGB(8, 10, 16),
		Material = Enum.Material.SmoothPlastic,
	})
	local monitorGui = Instance.new("SurfaceGui")
	monitorGui.Name = "Monitor"
	monitorGui.Face = Enum.NormalId.Right
	monitorGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	monitorGui.PixelsPerStud = 50
	monitorGui.Parent = screenPart

	local monitorBg = Instance.new("Frame")
	monitorBg.Size = UDim2.fromScale(1, 1)
	monitorBg.BackgroundColor3 = Color3.fromRGB(8, 10, 16)
	monitorBg.BorderSizePixel = 0
	monitorBg.Parent = monitorGui

	local monitorTitle = Instance.new("TextLabel")
	monitorTitle.Size = UDim2.new(1, 0, 0, 64)
	monitorTitle.BackgroundTransparency = 1
	monitorTitle.Font = Enum.Font.GothamBold
	monitorTitle.TextColor3 = Color3.fromRGB(120, 210, 255)
	monitorTitle.TextScaled = true
	monitorTitle.Text = "🛰️ SATELLITE MONITOR"
	monitorTitle.Parent = monitorBg

	local monitorLabel = Instance.new("TextLabel")
	monitorLabel.Position = UDim2.new(0, 18, 0, 74)
	monitorLabel.Size = UDim2.new(1, -36, 1, -86)
	monitorLabel.BackgroundTransparency = 1
	monitorLabel.Font = Enum.Font.Code
	monitorLabel.TextColor3 = Color3.fromRGB(120, 255, 170)
	monitorLabel.TextXAlignment = Enum.TextXAlignment.Left
	monitorLabel.TextYAlignment = Enum.TextYAlignment.Top
	monitorLabel.TextSize = 24
	monitorLabel.Text = "Initializing..."
	monitorLabel.Parent = monitorBg

	return {
		Model = model,
		Rocket = rocket,
		RocketSeat = seat,
		RocketStart = rocketPad,
		BoardPrompt = boardPrompt,
		EngineFX = engineFX,
		SuitStation = suitStation,
		SuitPrompt = suitPrompt,
		OrbitSeat = orbitSeat,
		OrbitReturnPrompt = orbitReturnPrompt,
		Satellite = satellite,
		DescentRig = descentRig,
		DescentSeat = descentSeat,
		DescentStart = descentStart,
		DescentParked = descentParked,
		SurfaceGround = surfaceGround,
		SurfaceSpawn = surfaceSpawn,
		Rover = rover,
		RoverSeat = roverSeat,
		RoverDrivePrompt = roverDrivePrompt,
		SurfaceReturnPrompt = surfaceReturnPrompt,
		FlightConsole = flightConsole,
		FlightLabel = flightLabel,
		FlightCyclePrompt = flightCyclePrompt,
		Crawler = crawler,
		RocketVAB = rocketVAB,
		CrawlerVAB = crawlerVAB,
		CrawlerPad = crawlerPad,
		RolloutPrompt = rolloutPrompt,
		MonitorLabel = monitorLabel,
		OrbitDeck = orbitDeck,
		Artemis = artemis,
		ArtemisSeats = artemisSeats,
		ArtemisBoardPrompt = artemisBoardPrompt,
		ArtemisLaunchPrompt = artemisLaunchPrompt,
		ArtemisEngineFX = artemisEngineFX,
		ArtemisStart = artemisStart,
		ArtemisSign = artemisSign,
	}
end

return WorldBuilder
]]></string>
